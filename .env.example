# ------------------------------------------------------------------
# Real Estate CRM — backend configuration
# Copy this file to `.env` and adjust values. Never commit `.env`.
# ------------------------------------------------------------------

# development | production
APP_ENV=development

# Database (PDO / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=real_estate_crm
DB_USER=root
DB_PASS=

# Authentication
AUTH_COOKIE_NAME=recrm_session
AUTH_SESSION_HOURS=8
# Set to true when served over HTTPS
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_PATH=/
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_MINUTES=15

# Comma-separated list of origins allowed to call the API directly (dev only).
# Not needed when using the Vite dev proxy or same-origin production hosting.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------
# DEVELOPMENT-ONLY seed accounts (used by `php database/setup.php`).
# setup.php refuses to run when APP_ENV=production.
# Passwords must be 8+ chars with upper, lower and a digit.
# ------------------------------------------------------------------
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_USERNAME=superadmin
SEED_SUPER_ADMIN_EMAIL=superadmin@crm.local
SEED_SUPER_ADMIN_PASSWORD=change-me

SEED_ADMIN_NAME=Demo Admin
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@crm.local
SEED_ADMIN_PASSWORD=change-me

SEED_USER_NAME=Demo User
SEED_USER_USERNAME=user
SEED_USER_EMAIL=user@crm.local
SEED_USER_PASSWORD=change-me

# Phase 4 password recovery (SMTP credentials never committed)
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="N Real Estate"
