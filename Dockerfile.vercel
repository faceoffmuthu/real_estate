FROM dunglas/frankenphp:php8.3-bookworm

WORKDIR /app

# PHP extensions required by your CRM
RUN install-php-extensions \
    pdo_mysql \
    mbstring

# Install Composer
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

# Copy backend
COPY backend/ /app/

# Install PHP dependencies
RUN composer install --no-dev --optimize-autoloader --no-interaction

# Create writable log/storage directories
RUN mkdir -p /app/storage/logs \
    && chmod -R 775 /app/storage

# FrankenPHP listens on Vercel's PORT
ENV SERVER_NAME=":80"

CMD ["sh", "-c", "frankenphp php-server --listen 0.0.0.0:${PORT:-80} --root /app"]